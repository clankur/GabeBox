LIBRARY XboxWin32LoaderTrace.dll
EXPORTS
    CreateFileA=XboxTraceCreateFileA @1
    CreateFileW=XboxTraceCreateFileW @2
    GetFileAttributesA=XboxTraceGetFileAttributesA @3
    GetFileAttributesW=XboxTraceGetFileAttributesW @4
    GetModuleFileNameW=XboxOriginalGetModuleFileNameW @5
    GetProcAddress=XboxGetProcAddress @6
    LoadLibraryA=XboxLoadLibraryA @7
    _wfsopen=XboxTraceWfsopen @8
    fopen=XboxTraceFopen @9
    LoadLibraryExW=XboxLoadLibraryExW @10
    LoadLibraryW=XboxLoadLibraryW @11
