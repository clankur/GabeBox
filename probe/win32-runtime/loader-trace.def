LIBRARY XboxWin32LoaderTrace.dll
EXPORTS
    LoadLibraryA=XboxLoadLibraryA
    GetProcAddress=XboxGetProcAddress
    GetModuleFileNameW=XboxOriginalGetModuleFileNameW
    CreateFileW=XboxTraceCreateFileW
    CreateFileA=XboxTraceCreateFileA
    GetFileAttributesW=XboxTraceGetFileAttributesW
    GetFileAttributesA=XboxTraceGetFileAttributesA
    fopen=XboxTraceFopen
    _wfsopen=XboxTraceWfsopen
