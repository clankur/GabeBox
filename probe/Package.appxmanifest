<?xml version="1.0" encoding="utf-8"?>
<Package
    xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
    xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
    IgnorableNamespaces="uap">
  <Identity
      Name="XboxPortabilityProbe.ChildProcess"
      Publisher="CN=Xbox Portability Probe"
      Version="1.0.4.0"
      ProcessorArchitecture="x64" />
  <Properties>
    <DisplayName>Packaged process test</DisplayName>
    <PublisherDisplayName>Xbox Portability Probe</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>
  <Dependencies>
    <TargetDeviceFamily
        Name="Windows.Universal"
        MinVersion="10.0.16299.0"
        MaxVersionTested="10.0.26100.0" />
  </Dependencies>
  <Resources>
    <Resource Language="en-US" />
  </Resources>
  <Applications>
    <Application
        Id="App"
      Executable="probe.exe"
        EntryPoint="Probe.App">
      <uap:VisualElements
          DisplayName="Packaged process test"
          Description="Measures launching one fixed packaged child process"
          BackgroundColor="#202020"
          Square150x150Logo="Assets\Logo.png"
          Square44x44Logo="Assets\SmallLogo.png">
        <uap:DefaultTile />
        <uap:SplashScreen Image="Assets\Splash.png" />
      </uap:VisualElements>
    </Application>
  </Applications>
  <Capabilities />
</Package>
