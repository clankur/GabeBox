+/* Persistent DXIL variant cache.
+ *
+ * A variant's DXIL depends only on the NIR handed to nir_to_dxil() and on the
+ * nir_to_dxil options, so the key is the serialized pre-compile NIR plus every
+ * option field.  The variant key (d3d12_shader_key) is already reflected in
+ * that NIR through the lowering passes it selects.  The screen's disk cache
+ * adds the build and device identity.
+ *
+ * nir_to_dxil() also rewrites the NIR that the driver keeps for bindings,
+ * root signatures and later stages, so an entry stores the validated
+ * (signed) DXIL together with the NIR as nir_to_dxil() left it.  A hit
+ * restores both and continues exactly as a compile would.
+ */
+#define D3D12_DXIL_CACHE_VERSION 1
+
+static int64_t
+d3d12_shader_cache_now(void)
+{
+   return os_time_get_nano();
+}
+
+void
+d3d12_shader_cache_write_stats(struct d3d12_screen *screen, bool force)
+{
+   if (!screen->shader_cache_stats_path)
+      return;
+
+   mtx_lock(&screen->shader_cache_mutex);
+   struct d3d12_shader_cache_stats *stats = &screen->shader_cache_stats;
+   const int64_t now = d3d12_shader_cache_now();
+   if (force || now - stats->last_write_ns >= 1000000000ll) {
+      stats->last_write_ns = now;
+      FILE *file = fopen(screen->shader_cache_stats_path, "w");
+      if (file) {
+         fprintf(file,
+                 "d3d12_shader_cache=%s\n"
+                 "variants=%" PRIu64 "\n"
+                 "hits=%" PRIu64 "\n"
+                 "misses=%" PRIu64 "\n"
+                 "uncached=%" PRIu64 "\n"
+                 "variant_us=%" PRIu64 "\n"
+                 "key_us=%" PRIu64 "\n"
+                 "load_us=%" PRIu64 "\n"
+                 "nir_to_dxil_us=%" PRIu64 "\n"
+                 "validate_us=%" PRIu64 "\n",
+                 screen->disk_cache ? "enabled" : "disabled",
+                 stats->variants, stats->hits, stats->misses, stats->uncached,
+                 stats->variant_ns / 1000, stats->key_ns / 1000,
+                 stats->load_ns / 1000, stats->nir_to_dxil_ns / 1000,
+                 stats->validate_ns / 1000);
+         /* Whether entries reach the disk, and the first failed file
+          * operation if they do not.
+          */
+         disk_cache_print_diagnostics(screen->disk_cache, file);
+         fclose(file);
+      }
+   }
+   mtx_unlock(&screen->shader_cache_mutex);
+}
+
+static void
+d3d12_shader_cache_count(struct d3d12_screen *screen, uint64_t *counter,
+                         int64_t start)
+{
+   if (!screen->shader_cache_stats_path)
+      return;
+
+   const int64_t elapsed = d3d12_shader_cache_now() - start;
+   mtx_lock(&screen->shader_cache_mutex);
+   *counter += elapsed > 0 ? (uint64_t)elapsed : 0;
+   mtx_unlock(&screen->shader_cache_mutex);
+}
+
+static bool
+d3d12_dxil_cache_usable(struct d3d12_context *ctx)
+{
+#ifdef _WIN32
+   struct d3d12_screen *screen = d3d12_screen(ctx->base.screen);
+
+   /* Debug output and unvalidated DXIL always go through the compiler. */
+   return screen->disk_cache && ctx->dxil_validator &&
+          !(d3d12_debug & (D3D12_DEBUG_EXPERIMENTAL | D3D12_DEBUG_DXIL |
+                           D3D12_DEBUG_DISASS | D3D12_DEBUG_VERBOSE));
+#else
+   (void)ctx;
+   return false;
+#endif
+}
+
+static bool
+d3d12_dxil_cache_key(struct d3d12_screen *screen, const nir_shader *nir,
+                     const struct nir_to_dxil_options *opts, cache_key key)
+{
+   struct blob blob;
+   blob_init(&blob);
+   blob_write_uint32(&blob, D3D12_DXIL_CACHE_VERSION);
+   blob_write_uint8(&blob, opts->interpolate_at_vertex);
+   blob_write_uint8(&blob, opts->lower_int16);
+   blob_write_uint8(&blob, opts->disable_math_refactoring);
+   blob_write_uint8(&blob, opts->last_ubo_is_not_arrayed);
+   blob_write_uint8(&blob, opts->advanced_texture_ops);
+   blob_write_uint32(&blob, opts->provoking_vertex);
+   blob_write_uint32(&blob, opts->num_kernel_globals);
+   blob_write_uint32(&blob, opts->input_clip_size);
+   blob_write_uint32(&blob, (uint32_t)opts->environment);
+   blob_write_uint32(&blob, (uint32_t)opts->shader_model_max);
+   blob_write_uint32(&blob, (uint32_t)opts->validator_version_max);
+   nir_serialize(&blob, nir, false);
+
+   const bool ok = !blob.out_of_memory;
+   if (ok)
+      disk_cache_compute_key(screen->disk_cache, blob.data, blob.size, key);
+   blob_finish(&blob);
+   return ok;
+}
+
+/* On a hit, returns the cached NIR (allocated on 'mem_ctx') and fills in the
+ * DXIL; otherwise returns NULL.
+ */
+static nir_shader *
+d3d12_dxil_cache_load(struct d3d12_screen *screen, void *mem_ctx,
+                      const nir_shader_compiler_options *options,
+                      const cache_key key, struct blob *dxil)
+{
+   size_t size = 0;
+   void *entry = disk_cache_get(screen->disk_cache, key, &size);
+   if (!entry)
+      return NULL;
+
+   struct blob_reader reader;
+   blob_reader_init(&reader, entry, size);
+   nir_shader *nir = NULL;
+   const uint32_t version = blob_read_uint32(&reader);
+   const uint32_t dxil_size = blob_read_uint32(&reader);
+   const void *dxil_data = blob_read_bytes(&reader, dxil_size);
+   if (!reader.overrun && version == D3D12_DXIL_CACHE_VERSION && dxil_size) {
+      nir = nir_deserialize(mem_ctx, options, &reader);
+      if (nir && (reader.overrun || reader.current != reader.end)) {
+         ralloc_free(nir);
+         nir = NULL;
+      }
+      if (nir && !blob_write_bytes(dxil, dxil_data, dxil_size)) {
+         ralloc_free(nir);
+         nir = NULL;
+      }
+   }
+
+   free(entry);
+   return nir;
+}
+
+UNUSED static void
+d3d12_dxil_cache_store(struct d3d12_screen *screen, const cache_key key,
+                       const nir_shader *nir, const void *dxil, size_t dxil_size)
+{
+   struct blob entry;
+   blob_init(&entry);
+   blob_write_uint32(&entry, D3D12_DXIL_CACHE_VERSION);
+   blob_write_uint32(&entry, (uint32_t)dxil_size);
+   blob_write_bytes(&entry, dxil, dxil_size);
+   nir_serialize(&entry, nir, false);
+   if (!entry.out_of_memory)
+      disk_cache_put(screen->disk_cache, key, entry.data, entry.size, NULL);
+   blob_finish(&entry);
+}
