+static struct disk_cache *
+d3d12_get_disk_shader_cache(struct pipe_screen *pscreen)
+{
+   return d3d12_screen(pscreen)->disk_cache;
+}
+
+/* The persistent shader cache backs both the GL front end's program cache
+ * (and with it GL_ARB_get_program_binary) and the DXIL variant cache in
+ * d3d12_compiler.cpp.
+ */
+static void
+d3d12_init_disk_cache(struct d3d12_screen *screen)
+{
+#if defined(ENABLE_SHADER_CACHE) && defined(_WIN32)
+   /* Windows has no per-user default cache location.  Leave the cache, and
+    * the program binary formats that depend on it, off unless the host
+    * names a directory.  DXIL_DEBUG dumps need real compiles, so they keep
+    * it off too.
+    */
+   if ((!os_get_option("MESA_SHADER_CACHE_DIR") &&
+        !os_get_option("MESA_GLSL_CACHE_DIR")) ||
+       os_get_option("DXIL_DEBUG"))
+      return;
+
+   /* Identify the build by its revision and build time, and the device by
+    * its IDs, driver version and the capabilities that shape NIR and DXIL.
+    */
+   static const char build_id[] =
+      "d3d12 shader cache 1 " PACKAGE_VERSION MESA_GIT_SHA1 " " __DATE__ " " __TIME__;
+   const uint32_t caps[] = {
+      (uint32_t)screen->max_shader_model,
+      (uint32_t)screen->max_feature_level,
+      screen->have_load_at_vertex,
+      screen->support_shader_images,
+      (uint32_t)screen->opts.DoublePrecisionFloatShaderOps,
+      (uint32_t)screen->opts1.Int64ShaderOps,
+      (uint32_t)screen->opts4.Native16BitShaderOpsSupported,
+      (uint32_t)screen->opts14.AdvancedTextureOpsSupported,
+   };
+   blake3_hasher hasher;
+   blake3_hash hash;
+   _mesa_blake3_init(&hasher);
+   _mesa_blake3_update(&hasher, build_id, sizeof(build_id));
+   _mesa_blake3_update(&hasher, &screen->vendor_id, sizeof(screen->vendor_id));
+   _mesa_blake3_update(&hasher, &screen->device_id, sizeof(screen->device_id));
+   _mesa_blake3_update(&hasher, &screen->subsys_id, sizeof(screen->subsys_id));
+   _mesa_blake3_update(&hasher, &screen->revision, sizeof(screen->revision));
+   _mesa_blake3_update(&hasher, &screen->driver_version, sizeof(screen->driver_version));
+   _mesa_blake3_update(&hasher, caps, sizeof(caps));
+   _mesa_blake3_final(&hasher, hash);
+
+   char driver_id[BLAKE3_HEX_LEN];
+   _mesa_blake3_format(driver_id, hash);
+   screen->disk_cache = disk_cache_create("d3d12", driver_id, 0);
+   if (screen->disk_cache) {
+      screen->shader_cache_stats_path = os_get_option_dup("D3D12_SHADER_CACHE_STATS");
+      /* Report the cache's state at once, before any variant is compiled. */
+      d3d12_shader_cache_write_stats(screen, true);
+   }
+#endif
+}
+#endif // HAVE_GALLIUM_D3D12_GRAPHICS
