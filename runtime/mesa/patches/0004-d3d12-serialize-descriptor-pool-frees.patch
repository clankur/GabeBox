+   /* d3d12_create_sampler_view allocates from the screen's view pool under
+    * descriptor_pool_mutex, from the frontend thread when the context is
+    * threaded; this free runs on the driver thread.
+    */
+   if (d3d12_descriptor_pool_lock_frees()) {
+      struct d3d12_screen *screen = d3d12_screen(pctx->screen);
+      mtx_lock(&screen->descriptor_pool_mutex);
+      d3d12_descriptor_handle_free(&view->handle);
+      mtx_unlock(&screen->descriptor_pool_mutex);
