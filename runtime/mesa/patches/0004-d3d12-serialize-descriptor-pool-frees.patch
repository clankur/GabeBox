+      d3d12_descriptor_handle_free(&view->handle);
+   }
    pipe_resource_reference(&view->base.texture, NULL);
    FREE(view);
 }
diff --git a/src/gallium/drivers/d3d12/d3d12_descriptor_pool.cpp b/src/gallium/drivers/d3d12/d3d12_descriptor_pool.cpp
--- a/src/gallium/drivers/d3d12/d3d12_descriptor_pool.cpp
+++ b/src/gallium/drivers/d3d12/d3d12_descriptor_pool.cpp
@@ -29,11 +29,144 @@
 #include "pipe/p_state.h"
 
 #include "util/list.h"
+#include "util/os_misc.h"
+#include "util/os_time.h"
+#include "util/u_call_once.h"
 #include "util/u_dynarray.h"
 #include "util/u_memory.h"
 
 #include <dxguids/dxguids.h>
 
+#include <atomic>
+#include <inttypes.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+/* Offline descriptor pool diagnostics.  Each tracked slot records the thread
+ * that allocated it, so an allocation of a live slot (two views sharing one
+ * CPU descriptor) and a free of a free slot are counted, as is any time two
+ * threads are inside the same pool heap at once.  The *_filetime fields are
+ * UTC FILETIMEs on Windows so they line up with other console traces.
+ */
+namespace {
+struct descriptor_pool_diag {
+   bool lock;
+   char *stats_path;
+   std::atomic<uint64_t> allocs;
+   std::atomic<uint64_t> frees;
+   std::atomic<uint64_t> dup_allocs;
+   std::atomic<uint64_t> double_frees;
+   std::atomic<uint64_t> overlaps;
+   std::atomic<uint64_t> cross_thread_frees;
+   std::atomic<uint64_t> first_dup_filetime;
+   std::atomic<uint64_t> first_double_free_filetime;
+   std::atomic<uint64_t> first_overlap_filetime;
+   std::atomic<int64_t> last_write_ns;
+   std::atomic<int> writing;
+};
+
+descriptor_pool_diag pool_diag;
+util_once_flag pool_diag_once = UTIL_ONCE_FLAG_INIT;
+
+uint64_t
+pool_diag_filetime(void)
+{
+#ifdef _WIN32
+   FILETIME now;
+   GetSystemTimeAsFileTime(&now);
+   return (static_cast<uint64_t>(now.dwHighDateTime) << 32) | now.dwLowDateTime;
+#else
+   return static_cast<uint64_t>(os_time_get_nano() / 100);
+#endif
+}
+
+uint32_t
+pool_diag_thread(void)
+{
+#ifdef _WIN32
+   return static_cast<uint32_t>(GetCurrentThreadId()) | 1u;
+#else
+   return 1u;
+#endif
+}
+
+void
+pool_diag_note(std::atomic<uint64_t> &counter, std::atomic<uint64_t> &first)
+{
+   counter.fetch_add(1);
+   uint64_t none = 0;
+   first.compare_exchange_strong(none, pool_diag_filetime());
+}
+
+void
+pool_diag_init(void)
+{
+   const char *lock = os_get_option("D3D12_DESCRIPTOR_POOL_LOCK");
+   pool_diag.lock = lock && !strcmp(lock, "1");
+   pool_diag.stats_path = os_get_option_dup("D3D12_DESCRIPTOR_STATS");
+   if (pool_diag.stats_path && !pool_diag.stats_path[0]) {
+      free(pool_diag.stats_path);
+      pool_diag.stats_path = NULL;
+   }
+   if (pool_diag.stats_path) {
+      FILE *file = fopen(pool_diag.stats_path, "w");
+      if (file) {
+         fprintf(file, "d3d12_descriptor_stats=1 lock=%d start_filetime=%" PRIu64 "\n",
+                 pool_diag.lock ? 1 : 0, pool_diag_filetime());
+         fclose(file);
+      }
+   }
+}
+
+void
+pool_diag_ensure_init(void)
+{
+   util_call_once(&pool_diag_once, pool_diag_init);
+}
+} // namespace
+
+bool
+d3d12_descriptor_pool_lock_frees(void)
+{
+   pool_diag_ensure_init();
+   return pool_diag.lock;
+}
+
+void
+d3d12_descriptor_pool_write_stats(bool threaded)
+{
+   pool_diag_ensure_init();
+   if (!pool_diag.stats_path)
+      return;
+
+   const int64_t now = os_time_get_nano();
+   if (now - pool_diag.last_write_ns.load() < 1000000000ll)
+      return;
+   int idle = 0;
+   if (!pool_diag.writing.compare_exchange_strong(idle, 1))
+      return;
+   pool_diag.last_write_ns.store(now);
+   FILE *file = fopen(pool_diag.stats_path, "a");
+   if (file) {
+      fprintf(file,
+              "filetime=%" PRIu64 " threaded=%d lock=%d allocs=%" PRIu64
+              " frees=%" PRIu64 " dup_allocs=%" PRIu64 " double_frees=%" PRIu64
+              " overlaps=%" PRIu64 " cross_thread_frees=%" PRIu64
+              " first_dup_filetime=%" PRIu64 " first_double_free_filetime=%" PRIu64
+              " first_overlap_filetime=%" PRIu64 "\n",
+              pool_diag_filetime(), threaded ? 1 : 0, pool_diag.lock ? 1 : 0,
+              pool_diag.allocs.load(), pool_diag.frees.load(),
+              pool_diag.dup_allocs.load(), pool_diag.double_frees.load(),
+              pool_diag.overlaps.load(), pool_diag.cross_thread_frees.load(),
+              pool_diag.first_dup_filetime.load(),
+              pool_diag.first_double_free_filetime.load(),
+              pool_diag.first_overlap_filetime.load());
+      fclose(file);
+   }
+   pool_diag.writing.store(0);
+}
+
 struct d3d12_descriptor_pool {
    ID3D12Device *dev;
    D3D12_DESCRIPTOR_HEAP_TYPE type;
@@ -54,8 +187,26 @@
    uint32_t next;
    util_dynarray free_list;
    list_head link;
+   /* Offline heaps only, with D3D12_DESCRIPTOR_STATS: the allocating thread
+    * of each slot (0 when free), and how many threads are inside the heap.
+    */
+   std::atomic<uint32_t> *owners;
+   std::atomic<int> busy;
 };
 
+static inline void
+pool_diag_enter(struct d3d12_descriptor_heap *heap)
+{
+   if (heap->busy.fetch_add(1) != 0)
+      pool_diag_note(pool_diag.overlaps, pool_diag.first_overlap_filetime);
+}
+
+static inline void
+pool_diag_leave(struct d3d12_descriptor_heap *heap)
+{
+   heap->busy.fetch_sub(1);
+}
+
 struct d3d12_descriptor_heap*
 d3d12_descriptor_heap_new(ID3D12Device *dev,
                           D3D12_DESCRIPTOR_HEAP_TYPE type,
@@ -81,6 +232,11 @@
       heap->gpu_base = GetGPUDescriptorHandleForHeapStart(heap->heap).ptr;
    heap->free_list = UTIL_DYNARRAY_INIT;
 
+   pool_diag_ensure_init();
+   if (pool_diag.stats_path && !(flags & D3D12_DESCRIPTOR_HEAP_FLAG_SHADER_VISIBLE))
+      heap->owners = static_cast<std::atomic<uint32_t> *>(
+         calloc(num_descriptors, sizeof(std::atomic<uint32_t>)));
+
    return heap;
 }
 
@@ -89,6 +245,7 @@
 {
    heap->heap->Release();
    util_dynarray_fini(&heap->free_list);
+   free(heap->owners);
    FREE(heap);
 }
 
@@ -135,17 +292,29 @@
 
    assert(handle != NULL);
 
+   if (heap->owners)
+      pool_diag_enter(heap);
+
    if (heap->free_list.size > 0) {
       offset = util_dynarray_pop(&heap->free_list, uint32_t);
    } else if (heap->size >= heap->next + heap->desc_size) {
       offset = heap->next;
       heap->next += heap->desc_size;
    } else {
+      if (heap->owners)
+         pool_diag_leave(heap);
       /* Todo: we should add a new descriptor heap to get more handles */
       assert(0 && "No handles available in descriptor heap");
       return 0;
    }
 
+   if (heap->owners) {
+      pool_diag.allocs.fetch_add(1);
+      if (heap->owners[offset / heap->desc_size].exchange(pool_diag_thread()) != 0)
+         pool_diag_note(pool_diag.dup_allocs, pool_diag.first_dup_filetime);
+      pool_diag_leave(heap);
+   }
+
    handle->heap = heap;
    handle->cpu_handle.ptr = heap->cpu_base + offset;
    handle->gpu_handle.ptr = d3d12_descriptor_heap_is_online(heap) ?
@@ -157,12 +326,24 @@
 void
 d3d12_descriptor_handle_free(struct d3d12_descriptor_handle *handle)
 {
-   const uint32_t index = static_cast<uint32_t>(handle->cpu_handle.ptr - handle->heap->cpu_base);
-   if (index + handle->heap->desc_size == handle->heap->next) {
-      handle->heap->next = index;
+   struct d3d12_descriptor_heap *heap = handle->heap;
+   const uint32_t index = static_cast<uint32_t>(handle->cpu_handle.ptr - heap->cpu_base);
+   if (heap->owners) {
+      pool_diag_enter(heap);
+      pool_diag.frees.fetch_add(1);
+      const uint32_t owner = heap->owners[index / heap->desc_size].exchange(0);
+      if (!owner)
+         pool_diag_note(pool_diag.double_frees, pool_diag.first_double_free_filetime);
+      else if (owner != pool_diag_thread())
+         pool_diag.cross_thread_frees.fetch_add(1);
+   }
+   if (index + heap->desc_size == heap->next) {
+      heap->next = index;
    } else {
-      util_dynarray_append(&handle->heap->free_list, index);
+      util_dynarray_append(&heap->free_list, index);
    }
+   if (heap->owners)
+      pool_diag_leave(heap);
 
    handle->heap = NULL;
    handle->cpu_handle.ptr = 0;
diff --git a/src/gallium/drivers/d3d12/d3d12_descriptor_pool.h b/src/gallium/drivers/d3d12/d3d12_descriptor_pool.h
--- a/src/gallium/drivers/d3d12/d3d12_descriptor_pool.h
+++ b/src/gallium/drivers/d3d12/d3d12_descriptor_pool.h
@@ -92,4 +92,18 @@
 void
 d3d12_descriptor_heap_clear(struct d3d12_descriptor_heap *heap);
 
+/* Offline descriptor pools are filled from the frontend thread
+ * (create_sampler_view, create_sampler_state) and freed from the threaded
+ * context's driver thread (sampler view and zombie sampler release).
+ * D3D12_DESCRIPTOR_POOL_LOCK=1 serializes those frees with
+ * d3d12_screen::descriptor_pool_mutex.  D3D12_DESCRIPTOR_STATS=<path>
+ * appends allocation counters, duplicate allocations, double frees and
+ * concurrent pool access to <path> at most once a second.
+ */
+bool
+d3d12_descriptor_pool_lock_frees(void);
+
+void
+d3d12_descriptor_pool_write_stats(bool threaded);
+
 #endif
