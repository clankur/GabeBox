+bool
+disk_cache_mmap_cache_index(void *mem_ctx, struct disk_cache *cache)
+{
+   bool mapped = false;
+   HANDLE file = INVALID_HANDLE_VALUE;
+   wchar_t *wide = NULL;
+   const char *operation = NULL;
+   DWORD error = ERROR_SUCCESS;
+
+   char *path = ralloc_asprintf(mem_ctx, "%s/index", cache->path);
+   if (path == NULL)
+      goto path_fail;
+
+   wide = win32_wide_path(path);
+   if (!wide) {
+      operation = "convert-path";
+      error = GetLastError();
+      goto path_fail;
+   }
+
+   file = CreateFile2(wide, GENERIC_READ | GENERIC_WRITE,
+                      FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE,
+                      OPEN_ALWAYS, NULL);
+   if (file == INVALID_HANDLE_VALUE) {
+      operation = "open-index";
+      error = GetLastError();
+      goto path_fail;
+   }
+
+   /* Force the index file to be the expected size. */
+   const size_t size = sizeof(*cache->size) + CACHE_INDEX_MAX_KEYS * CACHE_KEY_SIZE;
+   LARGE_INTEGER current;
+   if (!GetFileSizeEx(file, &current)) {
+      operation = "size-index";
+      error = GetLastError();
+      goto path_fail;
+   }
+   if ((uint64_t)current.QuadPart != size) {
+      LARGE_INTEGER end;
+      end.QuadPart = (LONGLONG)size;
+      if (!SetFilePointerEx(file, end, NULL, FILE_BEGIN) || !SetEndOfFile(file)) {
+         operation = "resize-index";
+         error = GetLastError();
+         goto path_fail;
+      }
+   }
+
+   /* As on POSIX, the view is shared so that every process using the cache
+    * sees the same size and key index; dirty pages reach the file even if
+    * the process is terminated.
+    */
+#if WINAPI_FAMILY_PARTITION(WINAPI_PARTITION_DESKTOP)
+   HANDLE mapping = CreateFileMappingW(file, NULL, PAGE_READWRITE, 0, 0, NULL);
+#else
+   HANDLE mapping = CreateFileMappingFromApp(file, NULL, PAGE_READWRITE, 0, NULL);
 #endif
+   if (mapping == NULL) {
+      operation = "map-index";
+      error = GetLastError();
+      goto path_fail;
+   }
+
+#if WINAPI_FAMILY_PARTITION(WINAPI_PARTITION_DESKTOP)
+   void *view = MapViewOfFile(mapping, FILE_MAP_READ | FILE_MAP_WRITE, 0, 0, size);
+#else
+   void *view = MapViewOfFileFromApp(mapping, FILE_MAP_READ | FILE_MAP_WRITE, 0, size);
+#endif
+   if (view == NULL) {
+      operation = "view-index";
+      error = GetLastError();
+   }
+   /* The view keeps the section alive. */
+   CloseHandle(mapping);
+   if (view == NULL)
+      goto path_fail;
+
+   cache->index_mmap = view;
+   cache->index_mmap_size = size;
+
+   cache->size = (p_atomic_uint64_t *) cache->index_mmap;
+   cache->stored_keys = cache->index_mmap + sizeof(uint64_t);
+   mapped = true;
+
+path_fail:
+   if (operation)
+      win32_record_failure(operation, path, error);
+   if (file != INVALID_HANDLE_VALUE)
+      CloseHandle(file);
+   free(wide);
+
+   return mapped;
+}
+
+void
+disk_cache_destroy_mmap(struct disk_cache *cache)
+{
+   if (cache->index_mmap)
+      UnmapViewOfFile(cache->index_mmap);
+}
