+/* Windows backend for the multi-file cache (DISK_CACHE_MULTI_FILE).
+ *
+ * It keeps the POSIX layout and entry format: <dir>/<2 hex>/<62 hex> files
+ * written to a temporary file and renamed into place, plus a fixed-size
+ * "index" file mapped into every process that uses the cache.  It uses only
+ * Win32 calls that are available to AppContainer (UWP) binaries.
+ *
+ * Paths go to the wide-character file APIs in extended-length form
+ * (\\?\X:\...), with every separator a backslash.  Entry paths are the cache
+ * directory plus about 90 characters, so a packaged app's LocalState folder
+ * alone takes a temporary entry past MAX_PATH, where the C runtime's narrow
+ * file calls fail.
+ *
+ * A packaged process has no per-user default cache location, so the cache
+ * directory has to be named by MESA_SHADER_CACHE_DIR (or the deprecated
+ * MESA_GLSL_CACHE_DIR).  Without it the cache stays disabled.  The single
+ * file (Fossilize) and database caches are not available on Windows.
+ *
+ * The first failed file operation is kept with its path and Win32 error, and
+ * reported with the operation counters by disk_cache_print_diagnostics(),
+ * because a failure here is otherwise only visible as cache misses.
+ */
+
+static struct {
+   volatile LONG claimed;
+   volatile LONG ready;
+   const char *operation;
+   DWORD error;
+   char path[1024];
+} win32_first_failure;
+
+static volatile LONG win32_entries_written;
+static volatile LONG win32_write_failures;
+static volatile LONG win32_entries_read;
+static volatile LONG win32_read_failures;
+
+static void
+win32_record_failure(const char *operation, const char *path, DWORD error)
+{
+   if (InterlockedCompareExchange(&win32_first_failure.claimed, 1, 0) != 0)
+      return;
+
+   win32_first_failure.operation = operation;
+   win32_first_failure.error = error;
+   snprintf(win32_first_failure.path, sizeof(win32_first_failure.path), "%s",
+            path ? path : "");
+   InterlockedExchange(&win32_first_failure.ready, 1);
+}
+
+void
+disk_cache_os_print_diagnostics(FILE *file)
+{
+   fprintf(file,
+           "disk_cache_entries_written=%ld\n"
+           "disk_cache_write_failures=%ld\n"
+           "disk_cache_entries_read=%ld\n"
+           "disk_cache_read_failures=%ld\n",
+           InterlockedCompareExchange(&win32_entries_written, 0, 0),
+           InterlockedCompareExchange(&win32_write_failures, 0, 0),
+           InterlockedCompareExchange(&win32_entries_read, 0, 0),
+           InterlockedCompareExchange(&win32_read_failures, 0, 0));
+
+   if (InterlockedCompareExchange(&win32_first_failure.ready, 0, 0))
+      fprintf(file, "disk_cache_first_failure=%s error=0x%08lx path=%s\n",
+              win32_first_failure.operation,
+              (unsigned long)win32_first_failure.error,
+              win32_first_failure.path);
+   else
+      fprintf(file, "disk_cache_first_failure=none\n");
+}
+
+/* Windows reports file sizes rather than allocated blocks.  Account in 4 KiB
+ * clusters so that additions and evictions use the same unit.
+ */
+static uint64_t
+win32_disk_size(uint64_t bytes)
+{
+   return (bytes + 4095) & ~(uint64_t)4095;
+}
+
+static bool
+win32_is_separator(wchar_t c)
+{
+   return c == L'\\' || c == L'/';
+}
+
+static bool
+win32_has_dot_component(const wchar_t *path)
+{
+   for (const wchar_t *part = path; *part;) {
+      if (win32_is_separator(*part)) {
+         part++;
+         continue;
+      }
+      const wchar_t *end = part;
+      while (*end && !win32_is_separator(*end))
+         end++;
+      if ((end - part == 1 && part[0] == L'.') ||
+          (end - part == 2 && part[0] == L'.' && part[1] == L'.'))
+         return true;
+      part = end;
+   }
+   return false;
+}
+
+/* Returns a heap copy of the UTF-8 'path' as a wide string for the Win32 file
+ * APIs, or NULL.  Separators become backslashes and repeated separators
+ * collapse.  An absolute drive or UNC path gets the extended-length prefix
+ * (\\?\ or \\?\UNC\), which lifts MAX_PATH; a path that already has a \\?\
+ * or \\.\ prefix keeps it.  Relative paths and paths with "." or ".."
+ * components are passed on without the prefix, because the extended form
+ * does not resolve them.
+ */
+static wchar_t *
+win32_wide_path(const char *path)
+{
+   const int count = MultiByteToWideChar(CP_UTF8, 0, path, -1, NULL, 0);
+   if (count <= 0)
+      return NULL;
+
+   wchar_t *source = malloc((size_t)count * sizeof(wchar_t));
+   if (!source)
+      return NULL;
+   if (MultiByteToWideChar(CP_UTF8, 0, path, -1, source, count) != count) {
+      free(source);
+      return NULL;
+   }
+
+   /* "\\?\UNC\" is the longest prefix; the result is never longer than the
+    * source plus that prefix.
+    */
+   wchar_t *result = malloc(((size_t)count + 8) * sizeof(wchar_t));
+   if (!result) {
+      free(source);
+      return NULL;
+   }
+
+   const wchar_t *in = source;
+   wchar_t *out = result;
+   const bool verbatim = win32_is_separator(in[0]) && win32_is_separator(in[1]) &&
+                         (in[2] == L'?' || in[2] == L'.') && win32_is_separator(in[3]);
+   const bool drive = ((in[0] | 0x20) >= L'a' && (in[0] | 0x20) <= L'z') &&
+                      in[1] == L':' && win32_is_separator(in[2]);
+   const bool unc = !verbatim && win32_is_separator(in[0]) && win32_is_separator(in[1]);
+   const bool extend = (drive || unc) && !win32_has_dot_component(in);
+
+   if (verbatim) {
+      memcpy(out, L"\\\\", 2 * sizeof(wchar_t));
+      out[2] = in[2];
+      out[3] = L'\\';
+      out += 4;
+      in += 4;
+   } else if (extend && drive) {
+      memcpy(out, L"\\\\?\\", 4 * sizeof(wchar_t));
+      out += 4;
+   } else if (extend && unc) {
+      memcpy(out, L"\\\\?\\UNC\\", 8 * sizeof(wchar_t));
+      out += 8;
+      in += 2;
+   } else if (unc) {
+      memcpy(out, L"\\\\", 2 * sizeof(wchar_t));
+      out += 2;
+      in += 2;
+   }
+
+   for (; *in; in++) {
+      if (!win32_is_separator(*in)) {
+         *out++ = *in;
+      } else if (out == result || out[-1] != L'\\') {
+         *out++ = L'\\';
+      }
+   }
+   /* Keep the separator of a drive root such as "C:\". */
+   if (out - result > 1 && out[-1] == L'\\' && out[-2] != L':')
+      out--;
+   *out = L'\0';
+
+   free(source);
+   return result;
+}
+
+/* Length of the root that is never created: "\\?\C:", "C:",
+ * "\\?\UNC\server\share" or "\\server\share".  0 for other paths.
+ */
+static size_t
+win32_root_length(const wchar_t *path)
+{
+   size_t start;
+   if (wcsncmp(path, L"\\\\?\\UNC\\", 8) == 0) {
+      start = 8;
+   } else if (wcsncmp(path, L"\\\\?\\", 4) == 0 ||
+              wcsncmp(path, L"\\\\.\\", 4) == 0) {
+      /* A drive, device or volume name ends at the first separator. */
+      const wchar_t *end = wcschr(path + 4, L'\\');
+      return end ? (size_t)(end - path) : wcslen(path);
+   } else if (path[0] == L'\\' && path[1] == L'\\') {
+      start = 2;
+   } else if (path[0] && path[1] == L':') {
+      return 2;
+   } else {
+      return 0;
+   }
+
+   /* server\share */
+   const wchar_t *server = wcschr(path + start, L'\\');
+   if (!server)
+      return wcslen(path);
+   const wchar_t *share = wcschr(server + 1, L'\\');
+   return share ? (size_t)(share - path) : wcslen(path);
+}
+
+static DWORD
+win32_directory_state(const wchar_t *path)
+{
+   WIN32_FILE_ATTRIBUTE_DATA data;
+   if (!GetFileAttributesExW(path, GetFileExInfoStandard, &data))
+      return GetLastError();
+   return (data.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY) ?
+          ERROR_SUCCESS : ERROR_DIRECTORY;
+}
+
+/* Create the directory 'path' and any missing parents, from the deepest
+ * existing one down.  Folders that already exist are never created again,
+ * which matters because an AppContainer may not inspect or create the
+ * folders above its own storage.  Returns a Win32 error code.
+ */
+static DWORD
+win32_create_directory(wchar_t *path, unsigned depth)
+{
+   if (CreateDirectoryW(path, NULL))
+      return ERROR_SUCCESS;
+
+   DWORD error = GetLastError();
+   if (error == ERROR_ALREADY_EXISTS || error == ERROR_ACCESS_DENIED) {
+      /* Access is also denied for an existing folder the caller may not
+       * create, such as a drive root.
+       */
+      const DWORD state = win32_directory_state(path);
+      return state == ERROR_SUCCESS ? ERROR_SUCCESS :
+             error == ERROR_ALREADY_EXISTS ? state : error;
+   }
+   if (error != ERROR_PATH_NOT_FOUND || depth >= 64)
+      return error;
+
+   wchar_t *separator = wcsrchr(path, L'\\');
+   if (!separator || (size_t)(separator - path) <= win32_root_length(path))
+      return error;
+
+   *separator = L'\0';
+   const DWORD parent = win32_create_directory(path, depth + 1);
+   *separator = L'\\';
+   if (parent != ERROR_SUCCESS)
+      return parent;
+
+   if (CreateDirectoryW(path, NULL))
+      return ERROR_SUCCESS;
+   error = GetLastError();
+   return error == ERROR_ALREADY_EXISTS ? win32_directory_state(path) : error;
+}
+
+/* Find or, when 'mkdir' is set, create the directory 'path' (UTF-8).
+ * Failures are recorded for diagnostics.
+ */
+static bool
+win32_find_or_create_dir(const char *path, bool mkdir)
+{
+   wchar_t *wide = win32_wide_path(path);
+   if (!wide) {
+      win32_record_failure("convert-path", path, GetLastError());
+      return false;
+   }
+
+   const DWORD error = mkdir ? win32_create_directory(wide, 0) :
+                               win32_directory_state(wide);
+   free(wide);
+   if (error == ERROR_SUCCESS)
+      return true;
+
+   if (mkdir) {
+      win32_record_failure("create-directory", path, error);
+      fprintf(stderr, "Failed to create %s for shader cache (error 0x%08lx)"
+                      "---disabling.\n", path, (unsigned long)error);
+   }
+   return false;
+}
+
+static char *
+win32_concatenate_and_mkdir(void *ctx, const char *path, const char *name,
+                            bool mkdir)
+{
+   char *new_path = ralloc_asprintf(ctx, "%s/%s", path, name);
+
+   if (new_path && win32_find_or_create_dir(new_path, mkdir))
+      return new_path;
+
+   return NULL;
+}
+
+static void
+win32_make_cache_file_directory(struct disk_cache *cache, const cache_key key)
+{
+   char buf[BLAKE3_HEX_LEN];
+   char *dir;
+
+   _mesa_blake3_format(buf, key);
+   if (asprintf(&dir, "%s/%c%c", cache->path, buf[0], buf[1]) == -1)
+      return;
+
+   win32_find_or_create_dir(dir, true);
+   free(dir);
+}
+
+static bool
+win32_read_all(HANDLE file, void *buf, size_t count)
+{
+   char *in = buf;
+   size_t done = 0;
+
+   while (done < count) {
+      const DWORD chunk = (DWORD)MIN2(count - done, (size_t)1 << 30);
+      DWORD read = 0;
+      if (!ReadFile(file, in + done, chunk, &read, NULL) || read == 0)
+         return false;
+      done += read;
+   }
+   return true;
+}
+
+static bool
+win32_write_all(HANDLE file, const void *buf, size_t count)
+{
+   const char *out = buf;
+   size_t done = 0;
+
+   while (done < count) {
+      const DWORD chunk = (DWORD)MIN2(count - done, (size_t)1 << 30);
+      DWORD written = 0;
+      if (!WriteFile(file, out + done, chunk, &written, NULL) || written == 0)
+         return false;
+      done += written;
+   }
+   return true;
+}
+
+static uint64_t
+win32_file_time(FILETIME time)
+{
+   return ((uint64_t)time.dwHighDateTime << 32) | time.dwLowDateTime;
+}
+
+/* Remove the least recently used entry in one two-character directory.
+ * Returns the accounted size of the removed file, or 0 if none was removed.
+ */
+static uint64_t
+win32_unlink_lru_file_from_directory(const char *dir_path)
+{
+   char *pattern;
+   if (asprintf(&pattern, "%s/*", dir_path) == -1)
+      return 0;
+
+   wchar_t *wide_pattern = win32_wide_path(pattern);
+   free(pattern);
+   if (!wide_pattern)
+      return 0;
+
+   WIN32_FIND_DATAW entry;
+   HANDLE find = FindFirstFileExW(wide_pattern, FindExInfoBasic, &entry,
+                                  FindExSearchNameMatch, NULL, 0);
+   free(wide_pattern);
+   if (find == INVALID_HANDLE_VALUE)
+      return 0;
+
+   wchar_t lru_name[MAX_PATH];
+   uint64_t lru_time = 0;
+   uint64_t lru_size = 0;
+   bool found = false;
+   do {
+      const size_t length = wcslen(entry.cFileName);
+      if ((entry.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY) ||
+          length >= ARRAY_SIZE(lru_name) ||
+          (length >= 4 && wcscmp(entry.cFileName + length - 4, L".tmp") == 0))
+         continue;
+
+      /* Last-access updates are often disabled on NTFS, so a written entry
+       * counts as used when it was written.
+       */
+      const uint64_t used = MAX2(win32_file_time(entry.ftLastAccessTime),
+                                 win32_file_time(entry.ftLastWriteTime));
+      if (!found || used < lru_time) {
+         found = true;
+         lru_time = used;
+         lru_size = ((uint64_t)entry.nFileSizeHigh << 32) | entry.nFileSizeLow;
+         memcpy(lru_name, entry.cFileName, (length + 1) * sizeof(wchar_t));
+      }
+   } while (FindNextFileW(find, &entry));
+   FindClose(find);
+
+   if (!found)
+      return 0;
+
+   char *dir;
+   if (asprintf(&dir, "%s/", dir_path) == -1)
+      return 0;
+   wchar_t *wide_dir = win32_wide_path(dir);
+   free(dir);
+   if (!wide_dir)
+      return 0;
+
+   /* win32_wide_path drops the trailing separator. */
+   const size_t dir_length = wcslen(wide_dir);
+   const size_t name_length = wcslen(lru_name);
+   wchar_t *path = malloc((dir_length + name_length + 2) * sizeof(wchar_t));
+   uint64_t size = 0;
+   if (path) {
+      memcpy(path, wide_dir, dir_length * sizeof(wchar_t));
+      path[dir_length] = L'\\';
+      memcpy(path + dir_length + 1, lru_name, (name_length + 1) * sizeof(wchar_t));
+      if (DeleteFileW(path))
+         size = win32_disk_size(lru_size);
+      free(path);
+   }
+   free(wide_dir);
+   return size;
+}
+
+void
+disk_cache_evict_lru_item(struct disk_cache *cache)
+{
+   /* Start from a random two-character directory, as the POSIX backend
+    * does, and move on until an entry is found.
+    */
+   uint64_t start = rand_xorshift128plus(cache->seed_xorshift128plus);
+   for (unsigned i = 0; i < 256; i++) {
+      char *dir_path;
+      if (asprintf(&dir_path, "%s/%02x", cache->path,
+                   (unsigned)((start + i) & 0xff)) == -1)
+         return;
+
+      uint64_t size = win32_unlink_lru_file_from_directory(dir_path);
+      free(dir_path);
+      if (size) {
+         p_atomic_add(&cache->size->value, - (uint64_t)size);
+         return;
+      }
+   }
+}
+
+void
+disk_cache_evict_item(struct disk_cache *cache, char *filename)
+{
+   wchar_t *wide = win32_wide_path(filename);
+   WIN32_FILE_ATTRIBUTE_DATA data;
+
+   if (wide && GetFileAttributesExW(wide, GetFileExInfoStandard, &data) &&
+       DeleteFileW(wide)) {
+      const uint64_t bytes = ((uint64_t)data.nFileSizeHigh << 32) | data.nFileSizeLow;
+      p_atomic_add(&cache->size->value, - (uint64_t)win32_disk_size(bytes));
+   }
+
+   free(wide);
+   free(filename);
+}
+
+static bool
+win32_missing(DWORD error)
+{
+   return error == ERROR_FILE_NOT_FOUND || error == ERROR_PATH_NOT_FOUND;
+}
+
+void *
+disk_cache_load_item(struct disk_cache *cache, char *filename, size_t *size)
+{
+   uint8_t *data = NULL;
+   uint8_t *uncompressed_data = NULL;
+   HANDLE file = INVALID_HANDLE_VALUE;
+   wchar_t *wide = win32_wide_path(filename);
+
+   if (!wide) {
+      win32_record_failure("convert-path", filename, GetLastError());
+      InterlockedIncrement(&win32_read_failures);
+      goto fail;
+   }
+
+   /* Delete sharing lets eviction remove an entry that is being read. */
+   file = CreateFile2(wide, GENERIC_READ,
+                      FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE,
+                      OPEN_EXISTING, NULL);
+   if (file == INVALID_HANDLE_VALUE) {
+      /* A missing entry is an ordinary cache miss. */
+      const DWORD error = GetLastError();
+      if (!win32_missing(error)) {
+         win32_record_failure("open-entry", filename, error);
+         InterlockedIncrement(&win32_read_failures);
+      }
+      goto fail;
+   }
+
+   LARGE_INTEGER file_size;
+   if (!GetFileSizeEx(file, &file_size) || file_size.QuadPart <= 0 ||
+       (uint64_t)file_size.QuadPart > SIZE_MAX) {
+      win32_record_failure("size-entry", filename, GetLastError());
+      InterlockedIncrement(&win32_read_failures);
+      goto fail;
+   }
+
+   data = malloc((size_t)file_size.QuadPart);
+   if (data == NULL)
+      goto fail;
+
+   /* Read entire file into memory */
+   if (!win32_read_all(file, data, (size_t)file_size.QuadPart)) {
+      win32_record_failure("read-entry", filename, GetLastError());
+      InterlockedIncrement(&win32_read_failures);
+      goto fail;
+   }
+
+   uncompressed_data =
+      parse_and_validate_cache_item(cache, data, (size_t)file_size.QuadPart, size);
+   if (uncompressed_data) {
+      InterlockedIncrement(&win32_entries_read);
+   } else {
+      win32_record_failure("validate-entry", filename, ERROR_INVALID_DATA);
+      InterlockedIncrement(&win32_read_failures);
+   }
+
+ fail:
+   free(data);
+   free(wide);
+   free(filename);
+   if (file != INVALID_HANDLE_VALUE)
+      CloseHandle(file);
+
+   return uncompressed_data;
+}
+
+void
+disk_cache_write_item_to_disk(struct disk_cache_put_job *dc_job,
+                              char *filename)
+{
+   HANDLE file = INVALID_HANDLE_VALUE;
+   wchar_t *wide = NULL;
+   wchar_t *wide_tmp = NULL;
+   char *filename_tmp = NULL;
+   const char *operation = NULL;
+   const char *failed_path = filename;
+   DWORD error = ERROR_SUCCESS;
+   struct blob cache_blob;
+   blob_init(&cache_blob);
+
+   /* Write to a temporary file and rename it into place, so that readers
+    * never see a partially written entry.
+    */
+   if (asprintf(&filename_tmp, "%s.tmp", filename) == -1) {
+      filename_tmp = NULL;
+      goto done;
+   }
+
+   wide = win32_wide_path(filename);
+   wide_tmp = win32_wide_path(filename_tmp);
+   if (!wide || !wide_tmp) {
+      operation = "convert-path";
+      error = GetLastError();
+      goto done;
+   }
+
+   /* Opening the temporary file without sharing stands in for the POSIX
+    * flock(): if another writer holds it open, that writer finishes the
+    * entry.  A temporary file left by a process that exited is truncated
+    * and reused.
+    */
+   file = CreateFile2(wide_tmp, GENERIC_WRITE, 0, CREATE_ALWAYS, NULL);
+   if (file == INVALID_HANDLE_VALUE && GetLastError() == ERROR_PATH_NOT_FOUND) {
+      /* Make the two-character subdirectory within the cache as needed. */
+      win32_make_cache_file_directory(dc_job->cache, dc_job->key);
+      file = CreateFile2(wide_tmp, GENERIC_WRITE, 0, CREATE_ALWAYS, NULL);
+   }
+   if (file == INVALID_HANDLE_VALUE) {
+      error = GetLastError();
+      if (error != ERROR_SHARING_VIOLATION) {
+         operation = "create-temporary";
+         failed_path = filename_tmp;
+      }
+      goto done;
+   }
+
+   /* If the destination exists, another process won the race between when
+    * we saw that the file didn't exist and now.
+    */
+   WIN32_FILE_ATTRIBUTE_DATA existing;
+   if (GetFileAttributesExW(wide, GetFileExInfoStandard, &existing))
+      goto remove_tmp;
+
+   if (!create_cache_item_header_and_blob(dc_job, &cache_blob)) {
+      operation = "serialize-entry";
+      error = ERROR_OUTOFMEMORY;
+      goto remove_tmp;
+   }
+
+   if (!win32_write_all(file, cache_blob.data, cache_blob.size)) {
+      operation = "write-temporary";
+      failed_path = filename_tmp;
+      error = GetLastError();
+      goto remove_tmp;
+   }
+
+   /* The temporary file has to be closed before it can be renamed, because
+    * it is open without delete sharing.
+    */
+   const BOOL closed = CloseHandle(file);
+   file = INVALID_HANDLE_VALUE;
+   if (!closed) {
+      operation = "close-temporary";
+      failed_path = filename_tmp;
+      error = GetLastError();
+      goto remove_tmp;
+   }
+
+   /* Without MOVEFILE_REPLACE_EXISTING an existing destination is kept,
+    * which keeps the size accounting right if another process wrote the
+    * entry meanwhile.  A sharing violation means another writer reopened
+    * the temporary file after it was closed; that writer finishes the entry.
+    */
+   if (!MoveFileExW(wide_tmp, wide, 0)) {
+      error = GetLastError();
+      if (error != ERROR_ALREADY_EXISTS && error != ERROR_FILE_EXISTS &&
+          error != ERROR_SHARING_VIOLATION)
+         operation = "rename-entry";
+      goto remove_tmp;
+   }
+
+   p_atomic_add(&dc_job->cache->size->value, win32_disk_size(cache_blob.size));
+   InterlockedIncrement(&win32_entries_written);
+   goto done;
+
+ remove_tmp:
+   if (file != INVALID_HANDLE_VALUE) {
+      CloseHandle(file);
+      file = INVALID_HANDLE_VALUE;
+   }
+   DeleteFileW(wide_tmp);
+
+ done:
+   if (operation) {
+      win32_record_failure(operation, failed_path, error);
+      InterlockedIncrement(&win32_write_failures);
+   }
+   if (file != INVALID_HANDLE_VALUE)
+      CloseHandle(file);
+   free(wide);
+   free(wide_tmp);
+   free(filename_tmp);
+   blob_finish(&cache_blob);
+}
+
+/* Returns the UTF-8 value of an environment variable on 'mem_ctx', or NULL
+ * if it is unset or empty.  The wide form is read so that a directory name
+ * outside the ANSI code page survives.
+ */
+static char *
+win32_get_option(void *mem_ctx, const wchar_t *name)
+{
+   const DWORD size = GetEnvironmentVariableW(name, NULL, 0);
+   if (size <= 1)
+      return NULL;
+
+   wchar_t *value = malloc(size * sizeof(wchar_t));
+   if (!value)
+      return NULL;
+
+   char *result = NULL;
+   const DWORD length = GetEnvironmentVariableW(name, value, size);
+   if (length > 0 && length < size) {
+      const int bytes = WideCharToMultiByte(CP_UTF8, 0, value, -1, NULL, 0, NULL, NULL);
+      if (bytes > 1) {
+         result = ralloc_size(mem_ctx, (size_t)bytes);
+         if (result &&
+             WideCharToMultiByte(CP_UTF8, 0, value, -1, result, bytes, NULL, NULL) != bytes) {
+            ralloc_free(result);
+            result = NULL;
+         }
+      }
+   }
+
+   free(value);
+   return result;
+}
+
+const char *
+disk_cache_generate_cache_dir(void *mem_ctx, const char *gpu_name,
+                              const char *driver_id,
+                              const char *cache_dir_name_custom,
+                              enum disk_cache_type cache_type,
+                              bool mkdir)
+{
+   const char *cache_dir_name = cache_dir_name_custom;
+
+   if (!cache_dir_name) {
+      cache_dir_name = CACHE_DIR_NAME;
+      if (cache_type == DISK_CACHE_SINGLE_FILE)
+         cache_dir_name = CACHE_DIR_NAME_SF;
+      else if (cache_type == DISK_CACHE_DATABASE)
+         cache_dir_name = CACHE_DIR_NAME_DB;
+   }
+
+   const char *path = win32_get_option(mem_ctx, L"MESA_SHADER_CACHE_DIR");
+   if (!path)
+      path = win32_get_option(mem_ctx, L"MESA_GLSL_CACHE_DIR");
+   if (!path) {
+      win32_record_failure("cache-directory-unset", "", ERROR_ENVVAR_NOT_FOUND);
+      return NULL;
+   }
+
+   path = win32_concatenate_and_mkdir(mem_ctx, path, cache_dir_name, mkdir);
+   if (path && cache_type == DISK_CACHE_SINGLE_FILE) {
+      path = win32_concatenate_and_mkdir(mem_ctx, path, driver_id, mkdir);
+      if (path)
+         path = win32_concatenate_and_mkdir(mem_ctx, path, gpu_name, mkdir);
+   }
+
+   return path;
+}
