namespace XboxProbe.Native
{
    runtimeclass ProbeRunner
    {
        static String Run();
        static String RunSteamCore(String inventory);
        static Windows.Foundation.IAsyncAction RunSteamRuntime(Windows.Storage.StorageFile file, String prefix);
        static Windows.Foundation.IAsyncOperation<String> RunSteamSignIn(Windows.Storage.StorageFile file, String prefix,
                                                                         String account, String approval, String accountId,
                                                                         Boolean remember, UInt32 expiresAt);
        static Windows.Foundation.IAsyncOperation<String> ResumeSteamSignIn(Windows.Storage.StorageFile file, String prefix);
        static Windows.Foundation.IAsyncOperation<Boolean> SignOutSteam();
        static Windows.Foundation.IAsyncOperation<String> QueueSteamDownload(UInt32 app);
        static String SteamDownloadStatus();
        static String SteamStorageInfo();
        static Windows.Foundation.IAsyncOperation<String> LaunchSteamGame(UInt32 app,
            Windows.Storage.StorageFile file, String prefix);
        static Windows.Foundation.IAsyncOperation<String> AuthorizeXcomDos(Windows.Storage.StorageFile file, String prefix);
        static Windows.Foundation.IAsyncOperation<String> AuthorizeDosGame(UInt32 app,
            Windows.Storage.StorageFile file, String prefix);
        static String StartLifetime();
        static String FinishLifetime();
        static Windows.Foundation.IAsyncOperation<String> RestoreSteamCloud(UInt32 app, Boolean preview);
        static Windows.Foundation.IAsyncOperation<String> LaunchSteamSdlGame(UInt32 app,
            Windows.Storage.StorageFile file, String prefix);
        static Windows.Storage.Streams.IBuffer SteamSdlFrame();
        static UInt32 SendSteamSdlInput(UInt32 pointer, UInt32 keys);
        static UInt32 SendSteamSdlGamepad(UInt32 buttons, Int32 leftX, Int32 leftY, Int32 rightX, Int32 rightY,
            Int32 leftTrigger, Int32 rightTrigger);
        static UInt32 SteamSdlGamepadAck();
        static Boolean SteamSdlKeyboardReady();
        static Boolean SendSteamSdlKey(UInt32 scan, Boolean down);
        static Boolean SendSteamSdlText(String text);
        static void ResetSteamSdlKeyboard();
        static Boolean SteamSdlRunning();
        static void QuitSteamSdl();
        static String SteamSdlRgbDeltaFrame(UInt32 previousSequence);
        static String SteamSessionSteamId();
        static UInt32 SteamSdlInputAck();
        static Windows.Foundation.IAsyncOperation<String> SteamLibraryCommand(String commandName, String commandArguments);
    };
}
