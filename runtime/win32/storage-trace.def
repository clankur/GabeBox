LIBRARY XboxWin32StorageTrace
EXPORTS
    CreateDirectoryW=XboxTraceCreateDirectoryW @1
    ExitProcess=XboxTraceExitProcess @2
    GetFileAttributesW=XboxTraceStorageAttributesW @3
    SetCurrentDirectoryW=XboxTraceSetCurrentDirectoryW @4
    TerminateProcess=XboxTraceTerminateProcess @5
    CreateFileW=XboxTraceStorageCreateFileW @6
    GetFinalPathNameByHandleW=XboxTraceFinalPathName @7
    GetCurrentDirectoryW=XboxTraceGetCurrentDirectoryW @8
